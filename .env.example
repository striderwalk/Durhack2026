# Copy the settings you need into your environment (this project doesn't load
# a .env file itself): for example
#   MODERATOR_EMAILS="a@durham.ac.uk,b@durham.ac.uk" python app.py

# Moderators: verified emails, comma-separated. Checked on every moderator
# request. Leave empty to have no moderators. Never commit real addresses.
MODERATOR_EMAILS=

# Shown to banned users as "Questions? Contact …". Leave empty for a placeholder.
MODERATION_CONTACT_EMAIL=
